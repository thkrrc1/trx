<?xml version="1.0"?>
<robot name="trx_s">

  <!-- hand -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://trx/urdf/meshes/hand.DAE"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
  </link>


  <!-- hand finger -->
  <link name="thumb_link">
    <visual>
      <geometry>
        <mesh filename="package://trx/urdf/meshes/thumb.DAE"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
  </link>
  <joint name="thumb_joint" type="revolute">
    <parent link="base_link"/>
    <child link="thumb_link"/>
    <origin xyz="0.023 0 0.054" rpy="0 -0.08 0"/>
    <axis   xyz="0 1 0"/>
    <limit lower="-2.0" upper="0.0" effort="50" velocity="10.0"/>
  </joint>



  <!-- hand index base -->
  <link name="indexbase_link">
    <visual>
      <geometry>
        <mesh filename="package://trx/urdf/meshes/index_base.DAE"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 -0 0"/>
    </visual>
  </link>
  <joint name="indexbase_joint" type="revolute">
    <parent link="base_link"/>
    <child  link="indexbase_link"/>
    <origin xyz="-0.013 0 0.087" rpy="0 -0 0"/>
    <axis   xyz="0 1 0"/>
    <limit lower="0.0" upper="1.2" effort="50" velocity="0.5"/>
  </joint>

  <!-- hand index middle -->
  <link name="indexmid_link">
    <visual>
      <geometry>
        <mesh filename="package://trx/urdf/meshes/index_mid.DAE"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
  </link>
  <joint name="indexmid_joint" type="revolute">
    <parent link="indexbase_link"/>
    <child  link="indexmid_link"/>
    <origin xyz="0 0 0.045" rpy="0 0.52 0"/>
    <axis   xyz="0 1 0"/>
    <limit lower="0.0" upper="0.8" effort="50" velocity="0.5"/>
  </joint>

  <!-- hand index end -->
  <link name="indexend_link">
    <visual>
      <geometry>
        <mesh filename="package://trx/urdf/meshes/index_end.DAE"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </visual>
  </link>
  <joint name="indexend_joint" type="revolute">
    <parent link="indexmid_link"/>
    <child  link="indexend_link"/>
    <origin xyz="-0.005 0 0.025" rpy="0 -1.13 0"/>
    <axis   xyz="0 1 0"/>
    <limit lower="0.0" upper="0.8" effort="50" velocity="0.5"/>
  </joint>

  <ros2_control name="SeedHW" type="system">
    <hardware>
      <plugin>trx/SeedHardwareInterface</plugin>
      <param name="serial_port">/dev/ttyACM0</param>
      <param name="can_id">1</param>
      <param name="controller_rate">20.0</param>
    </hardware>


    <joint name="indexbase_joint">
      <state_interface name="position"/>
    </joint>
    <joint name="indexmid_joint">
      <state_interface name="position"/>
    </joint>
    <joint name="indexend_joint">
      <state_interface name="position"/>
    </joint>
    <joint name="thumb_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

</robot>
